{
  "manifest_version": 3,
  "name": "LLM Wiki 网页剪藏",
  "version": "0.1.0",
  "description": "把当前网页发送到本地 LLM Wiki 知识库。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:19827/*",
    "http://127.0.0.1:19827/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
