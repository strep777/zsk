{
  "name": "llm-wiki-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Docker-ready web implementation of an LLM-compiled Markdown wiki workspace.",
  "scripts": {
    "dev": "concurrently \"npm:server:dev\" \"npm:client:dev\"",
    "client:dev": "vite --host 0.0.0.0",
    "server:dev": "tsx watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "node scripts/clean-test-temp.mjs && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "iconv-lite": "^0.7.2",
    "js-yaml": "^4.1.0",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/http-errors": "^2.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/qs": "^6.15.1",
    "@types/range-parser": "^1.2.7",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@types/send": "^1.2.1",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.18"
  }
}
